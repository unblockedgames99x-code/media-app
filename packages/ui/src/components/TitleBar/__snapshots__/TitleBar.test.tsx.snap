// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`TitleBar > (Snapshot) renders Mac variant 1`] = `
<div
  class="border-border surface-background relative flex h-6 items-center border-b-2 select-none justify-start"
  data-testid="title-bar"
>
  <div
    class="group flex items-center gap-1.5 pl-3"
    data-testid="mac-window-controls"
  >
    <button
      class="surface-accent-red outline-foreground h-3 w-3 rounded-full opacity-80 outline-2 group-hover:opacity-100"
      title="Close"
    />
    <button
      class="surface-accent-yellow outline-foreground h-3 w-3 rounded-full opacity-80 outline-2 group-hover:opacity-100"
      title="Minimize"
    />
    <button
      class="surface-accent-green outline-foreground h-3 w-3 rounded-full opacity-80 outline-2 group-hover:opacity-100"
      title="Maximize"
    />
  </div>
  <span
    class="text-foreground font-heading text-md pointer-events-none absolute inset-x-0 flex text-center font-medium"
  >
    <span
      class="flex w-full items-center justify-center gap-2"
    >
      My listening room
    </span>
  </span>
</div>
`;

