{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media",
  "mainBinaryName": "Media",
  "version": "1.50.1",
  "identifier": "com.cartermedia.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "cd ../.. && pnpm --filter @nuclearplayer/player build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Media",
        "width": 1280,
        "height": 720,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "shortDescription": "Music and videos in one desktop app",
    "longDescription": "A customizable music and video workspace with playlists, recommendations, plugins, and personal themes. Based on Nuclear and FreeTube, with original contributors and AGPL licenses preserved.",
    "copyright": "Copyright 2025-2026 nukeop",
    "homepage": "https://github.com/unblockedgames99x-code/media-app",
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "epoch": 0,
        "files": {},
        "release": "1"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "cartermedia"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRDk0QzBFODNCNDEyNUUKUldSZUVyU0REa3paYzdTaE9IdlErcjNoTmdyMkNLL0d3alFZTHVMcytxQzJ3K1NJRlFWQlVaYk4K",
      "endpoints": []
    }
  }
}
